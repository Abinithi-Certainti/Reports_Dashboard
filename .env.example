# Copy this file to .env (same folder) and fill in your values. .env is git-ignored: never commit it.
# Use the READ-ONLY login. Never paste the password into a chat.
PG_HOST=<QA server name - ask the tech lead, do not commit it>
PG_PORT=5432
PG_NAME=kios_etl
PG_USERNAME=readonly_user
PG_PASSWORD=
# Azure PostgreSQL needs SSL
PG_URL_PARAMS=?sslmode=require
