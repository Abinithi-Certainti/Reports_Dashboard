# Copy to my.env (git-ignored) and fill in. Never commit real values or paste them in a chat.
# Source = old SQL Server (read only; use a read-only login).
SRC_DRIVER=pymssql            # pymssql (no extra install) or pyodbc (needs the Microsoft ODBC driver)
SRC_HOST=
SRC_PORT=1433
SRC_DATABASE=
SRC_USER=
SRC_PASSWORD=
# Target = new Postgres (kios_etl). Use a login that may write to schema master.
TGT_HOST=
TGT_PORT=5432
TGT_DATABASE=kios_etl
TGT_USER=
TGT_PASSWORD=
TGT_SSLMODE=require           # Azure Postgres needs SSL
TGT_SCHEMA=master
