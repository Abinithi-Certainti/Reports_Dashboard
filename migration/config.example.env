# Copy to my.env (git-ignored) and fill in. Never commit real values or paste them in a chat.
# Write each value straight after "=": no quotes, and no comment on the same line (it would become part of the value).

# Source = where the old data is read from (read only).
# SRC_DRIVER:
#   pymssql  = the old SQL Server (no extra install)           <- for export.py, and for migrate.py direct
#   pyodbc   = the old SQL Server through the Microsoft ODBC driver
#   postgres = the local Postgres copy made by load_raw.py     <- for load_raw.py and migrate.py on the files path
SRC_DRIVER=pymssql
SRC_HOST=
# 1433 for SQL Server, 5432 for Postgres
SRC_PORT=1433
SRC_DATABASE=
SRC_USER=
SRC_PASSWORD=
# Only with SRC_DRIVER=postgres: the schema of the copy, and SSL (disable for a Postgres on this computer)
SRC_SCHEMA=src
SRC_SSLMODE=prefer

# Target = new Postgres (kios_etl, or a local database with the same tables). A dry run only reads; a real load
# needs a login that may write to schema master.
TGT_HOST=
TGT_PORT=5432
TGT_DATABASE=kios_etl
TGT_USER=
TGT_PASSWORD=
# Azure Postgres needs SSL (require); a Postgres on this computer: disable
TGT_SSLMODE=require
TGT_SCHEMA=master
